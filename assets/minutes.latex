\documentclass[12pt]{article}
\usepackage{xeCJK}
\usepackage[a4paper,top=2.2cm,bottom=2.2cm,left=2.4cm,right=2.4cm]{geometry}
\usepackage{longtable,array,booktabs}
\usepackage{fancyhdr}
\usepackage{xcolor}
\usepackage{enumitem}
\usepackage{hyperref}
\hypersetup{hidelinks}
% ★字体只用 latex-svc 容器里确实有的★(它的 Dockerfile 只装了 `fonts-noto-cjk`,
%   `texlive-fonts-extra` 被砍掉省 640MB —— 所以 **DejaVu 之类一律没有**,写了会挂)。
% ⚠ 西文正文**不显式指定**,用 LaTeX 默认(Latin Modern,texlive-fonts-recommended 里有)。
\setCJKmainfont{Noto Serif CJK SC}
\setCJKsansfont{Noto Sans CJK SC}
% ★等宽用 Noto Sans Mono CJK SC★:它**带中文字形** ——
%   行内 `code` 里混中文时不会掉字，而普通西文等宽字体遇到中文只能回退、字距就乱了。
%   (latex-svc 的 Dockerfile 注释里写着这一条就是「congrove 要的」。)
\setmonofont{Noto Sans Mono CJK SC}
\setCJKmonofont{Noto Sans Mono CJK SC}

% 页眉。★默认取活动的关联项目名★(2026-08-23 liaoruili 定;多个项目取第一个),
%   给不出来就整行不画。将来要固定成一个组织名的话,改的是**传进来的值**不是这里。
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\small\color{gray}$if(org)$「$org$」$endif$}
\fancyfoot[C]{\small\thepage}

% ★pandoc 生成的列表会用 \tightlist —— 自定义模板必须自己声明★
% (默认模板里有,换成自己的模板就没了,报「Undefined control sequence」)
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\setlength{\parindent}{2em}
\setlist[itemize]{leftmargin=2.4em,topsep=2pt,itemsep=1pt}
\setlist[enumerate]{leftmargin=2.4em,topsep=2pt,itemsep=1pt}

% 表格:左列固定宽的标签列,右列自适应
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
% ★正文格用这个列型★:`\raggedright` 不做两端对齐。
%   两端对齐 + 行内等宽英文(journal_list 这种)会把同一行的**中文字距拉开**
%   ——「导 入 接 口 测 试」,读起来像故障。这是 C7 记的那个「行内 code」问题的真正成因:
%   不是字体不对,是**为了对齐右边界而拉伸中文**。
% ★同时给单元格内的段落恢复首行缩进★:p{} 列里 \parindent 默认为 0。
\newcolumntype{B}[1]{>{\raggedright\arraybackslash\setlength{\parindent}{2em}}p{#1}}
% 居中列型。⚠ 不能在单元格里直接写 `\centering` —— 它会把行末的 `\\` 吃掉
%   (报 Undefined control sequence),必须配 `\arraybackslash`,所以做成列型。
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\renewcommand{\arraystretch}{1.45}

\begin{document}

\begin{center}
  {\LARGE\bfseries $title$}\\[14pt]
  {\Large\bfseries 会议总结}
\end{center}
$if(recorder)$
\hfill{\bfseries 记录人：$recorder$}\par\vspace{4pt}
$endif$

\begin{longtable}{|L{2.0cm}|C{4.2cm}|L{2.0cm}|L{6.3cm}|}
\hline
$if(subject)$
% ⚠ congrove 目前**没有**「会议主题(一句话概括)」这个字段 —— 活动只有一个标题,
%   而它已经印在上面的大标题上了。所以这一行做成可选:不传就不画,★不拿标题再填一遍充数★。
\textbf{会议主题} & \multicolumn{3}{c|}{$subject$} \\ \hline
$endif$
\textbf{会议时间} & \multicolumn{3}{c|}{$when$} \\ \hline
\textbf{主持人} & $host$ & \textbf{主讲人} & $if(speakers)$$speakers$$else$—$endif$ \\ \hline
\textbf{会议地点} & $place$ & \textbf{参会人} & $attendees$ \\ \hline
$if(observers)$
% ★旁听/缺席有才画★:congrove 有这两个字段而团队现用的 Word 格式里没有 ——
%   ★传了却不画就是静默丢数据★,所以补上;没有的场次整行不出现,不占版面。
\textbf{旁听人} & \multicolumn{3}{L{12.9cm}|}{$observers$} \\ \hline
$endif$
$if(absentees)$
\textbf{缺席人} & \multicolumn{3}{L{12.9cm}|}{$absentees$} \\ \hline
$endif$
$if(online)$
\textbf{线上} & \multicolumn{3}{L{12.9cm}|}{\texttt{$online$}} \\ \hline
$endif$
$if(agenda)$
\textbf{会议事项} & \multicolumn{3}{B{12.9cm}|}{$agenda$} \\ \hline
$endif$
\textbf{主要内容} & \multicolumn{3}{B{12.9cm}|}{$body$} \\ \hline
$if(resolutions)$
\textbf{决议事项} & \multicolumn{3}{B{12.9cm}|}{$resolutions$} \\ \hline
$endif$
$if(todos)$
\textbf{待办事项} & \multicolumn{3}{B{12.9cm}|}{$todos$} \\ \hline
$endif$
\end{longtable}

\end{document}
