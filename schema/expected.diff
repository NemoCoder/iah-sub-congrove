+VIEW activities_owing_minutes AS  SELECT m.id AS activity_id,
+    m.recorder,
+    m.title,
+    m.starts_at,
+    m.ends_at,
+    n.activity_id IS NOT NULL AS has_draft
+   FROM activities m
+     JOIN activity_types t ON t.id = m.type_id AND t.has_minutes
+     LEFT JOIN activity_minutes n ON n.activity_id = m.id
+  WHERE m.status = 'active'::text AND m.ends_at < now() AND (n.activity_id IS NULL OR n.status <> 'done'::text) AND NOT ((EXISTS ( SELECT 1
+           FROM activity_projects ap
+          WHERE ap.activity_id = m.id)) AND NOT (EXISTS ( SELECT 1
+           FROM activity_projects ap2
+             JOIN projects p2 ON p2.id = ap2.project_id AND p2.deleted_at IS NULL
+          WHERE ap2.activity_id = m.id)));
