# 本地开发:cp .env.example .env && cargo run(config.rs 缺 DATABASE_URL / S3_* 硬失败)。
# 本地默认不配 OIDC → 鉴权关闭 + 启动 WARN,require_auth 放行 dev 超管假身份,可裸连验证。
# dev 库/桶凭证从平台取:GET registry.ruciah.com/api/subsystems/congrove/credentials(带个人令牌)。

APP_ENV=dev
BIND_ADDR=0.0.0.0:8030

DATABASE_URL=postgresql://sub_congrove_dev:CHANGE_ME@localhost:5432/sub_congrove_dev

S3_ENDPOINT=http://localhost:3900
S3_BUCKET=sub-congrove-dev
S3_REGION=garage
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# 要本地验鉴权时再开(平台上这些全自动注入):
#OIDC_ISSUER=https://auth.ruciah.com/realms/iah
#OIDC_CLIENT_ID=sub-congrove
#OIDC_CLIENT_SECRET=
#AUTH_SECRET=
#CONGROVE_SUPER_USERS=liaoruili
#S3_PUBLIC_ENDPOINT=https://s3api.ruciah.com
